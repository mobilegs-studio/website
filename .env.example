# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# --- Supabase (Project Settings > API Keys) ---
# Public, shipped to the browser:
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only — bypasses RLS, used by the Stripe webhook. Keep secret:
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# --- Stripe (Developers > API keys, test mode) ---
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# From `stripe listen` (local) or the dashboard webhook endpoint:
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- App ---
# Used to build absolute redirect URLs. Set to the deployed URL on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
