#!/bin/sh
# Reminder: keep docs/SETUP-AND-ARCHITECTURE.md (sitemap & architecture) in sync.
# Fires when a commit touches files that define routes, stack, data model,
# components or brand tokens, and the doc itself was not updated in that commit.

watched='^(src/app/|src/components/|src/lib/supabase/|src/i18n/|src/content/|supabase/migrations/|src/middleware\.ts|src/app/globals\.css|package\.json)'

files=$(git diff-tree --no-commit-id --name-only -r HEAD)
changed=$(printf '%s\n' "$files" | grep -E "$watched")

if [ -n "$changed" ] && ! printf '%s\n' "$files" | grep -q '^docs/SETUP-AND-ARCHITECTURE\.md$'; then
  printf '\n\033[33m⚠  Sitemap/architectuur kan gewijzigd zijn — werk docs/SETUP-AND-ARCHITECTURE.md bij.\033[0m\n'
  printf '   Gewijzigde relevante bestanden:\n'
  printf '%s\n' "$changed" | sed 's/^/     /'
  printf '\n'
fi
